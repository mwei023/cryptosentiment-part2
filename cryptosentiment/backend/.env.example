# Backend environment — copy to .env and fill in.
# (Render injects DATABASE_URL, CORS_EXTRA_ORIGINS and DISABLE_HEAVY_MODELS
# from render.yaml; this file is for local development.)

DATABASE_URL=postgresql://user:password@localhost:5432/cryptosentiment
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# NewsAPI key (https://newsapi.org). Optional: journal runs fall back to
# empty news (info arm degrades to price-only) and /news returns 404.
NEWS_API_KEY=

# Celery (local dev only — on Render the journal runs via GitHub Actions,
# see .github/workflows/daily-journal.yml)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Set to 1 on instances with <1GB RAM (e.g. Render free web tier): sentiment
# endpoints return 503 and /predict confidence uses price data only.
DISABLE_HEAVY_MODELS=

# Comma-separated extra allowed CORS origins (deployed frontend URL).
# "*" allows any origin. Leave empty for local dev (localhost is always allowed).
CORS_EXTRA_ORIGINS=

# --- E006 journal (research/daily_report.py) ---
# Comma-separated CoinGecko ids to journal (default: bitcoin,ethereum,solana)
# JOURNAL_COINS=
# Set to 1 to journal the 7-coin expanded universe
# USE_EXPANDED_UNIVERSE=
